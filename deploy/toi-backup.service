[Unit]
Description=TOI online data backup

[Service]
Type=oneshot
User=toi
Group=toi
WorkingDirectory=/var/www/toi
EnvironmentFile=/var/www/toi/private/toi.env
ExecStart=/var/www/toi/.venv/bin/python /var/www/toi/deploy/backup_toi.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/toi
UMask=0077
