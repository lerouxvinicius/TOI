[Unit]
Description=TOI system health snapshot
After=toi-core.service

[Service]
Type=oneshot
User=toi
Group=toi
WorkingDirectory=/var/www/toi
EnvironmentFile=/var/www/toi/private/toi.env
ExecStart=/var/www/toi/.venv/bin/python /var/www/toi/TOI_INTELLIGENCE_READONLY_v1_2/tools_readonly/toi_system_health_readonly_v1_2.py --db /var/www/toi/dados_toi/live/toi_live.sqlite --json-out /var/www/toi/TOI_v1.10.6_DUAL_LANE_ML_SHADOW/static/toi_system_health_latest.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/toi/TOI_v1.10.6_DUAL_LANE_ML_SHADOW/static
UMask=0027
