# Copie para private/toi.env (modo 0600). Valores abaixo são apenas exemplos.

# Portal do discador
ORBE_BASE_URL=https://portal.example.com
ORBE_LOGIN=usuario
ORBE_PASSWORD=troque-me
ORBE_INSTANCIAS=1,2,4,5,6
ORBE_LIMITE_P34=10
ORBE_LIMITE_P135=5

# Media gateways e SBCs (somente leitura)
MGW_USER=monitor
MGW_PASSWORD=troque-me
SBC_SNMP_COMMUNITY=public
SBC_TRAP_COMMUNITY=public
SBC_ACLI_USER=monitor
SBC_ACLI_KEY=/var/www/toi/private/sbc_acli_key

# IPBX
IPBX_BASE_URL=https://ipbx.example.com
IPBX_ID_USER=0

# Notificações e chamados
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TICKETDESK_API_KEY=

# Assistente local (Ollama)
TOI_LOCAL_AI_URL=http://127.0.0.1:11434
TOI_LOCAL_AI_MODEL=llama3.1

# Backup
TOI_BACKUP_DIR=/var/backups/toi
TOI_BACKUP_KEEP_DAILY=30
TOI_BACKUP_KEEP_MONTHLY=12
